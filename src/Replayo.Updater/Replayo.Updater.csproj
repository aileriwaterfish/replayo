<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Journal.CheminForce sert uniquement aux tests du projet principal. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Replayo\Core\UpdateInstaller.cs" Link="UpdateInstaller.cs" />
    <Compile Include="..\Replayo\Core\Journal.cs" Link="Journal.cs" />
  </ItemGroup>
</Project>
