<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.1</Version>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>..\..\assets\replayo.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Le SDK WPF retire System.IO des usings implicites (conflit Shapes.Path) : on le rétablit. -->
    <Using Include="System.IO" />
    <!-- WPF + WinForms exposent les mêmes noms (Label, ComboBox…). On retire WinForms
         des usings implicites : le peu de code WinForms (tray, dialogue dossier) est en
         alias WF. ou pleinement qualifié. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Replayo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Link="ffmpeg.exe" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')" />
    <None Include="..\..\assets\clip.wav" CopyToOutputDirectory="PreserveNewest" Link="assets\clip.wav" Condition="Exists('..\..\assets\clip.wav')" />
    <None Include="..\..\assets\replayo.ico" CopyToOutputDirectory="PreserveNewest" Link="assets\replayo.ico" Condition="Exists('..\..\assets\replayo.ico')" />
    <None Include="..\..\assets\tray.ico" CopyToOutputDirectory="PreserveNewest" Link="assets\tray.ico" Condition="Exists('..\..\assets\tray.ico')" />
  </ItemGroup>

</Project>
